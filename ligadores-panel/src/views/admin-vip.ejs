<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head') %></head>
<body>
  <%- include('partials/nav') %>
  <main>
    <div class="container">
      <div class="page-head">
        <div class="eyebrow">Administración</div>
        <h1>Planes VIP</h1>
        <p>Edita nombre, precio y beneficios de cada plan. El nivel (bronce/plata/oro) es fijo porque tu script de FiveM depende de esos valores exactos.</p>
      </div>

      <% tiers.forEach(function(tier){ %>
        <form method="POST" action="/admin/vip/<%= tier.level %>/edit" class="card" style="margin-bottom:1.6rem;">
          <div class="stat-label" style="margin-bottom:1rem;">Nivel: <%= tier.level.toUpperCase() %></div>

          <label for="label-<%= tier.level %>">Nombre visible</label>
          <input type="text" id="label-<%= tier.level %>" name="label" value="<%= tier.label %>" required>

          <label for="price-<%= tier.level %>">Precio por mes (USD)</label>
          <input type="number" step="0.01" id="price-<%= tier.level %>" name="price_per_month" value="<%= tier.price_per_month %>" required>

          <label for="benefits-<%= tier.level %>">Beneficios (uno por línea)</label>
          <textarea id="benefits-<%= tier.level %>" name="benefits" style="min-height:120px;" required><%= tier.benefits %></textarea>

          <label for="role-<%= tier.level %>">ID del rol de Discord a asignar</label>
          <input type="text" id="role-<%= tier.level %>" name="discord_role_id" value="<%= tier.discord_role_id || '' %>" placeholder="123456789012345678">

          <button type="submit" class="btn btn-solid">Guardar cambios</button>
        </form>
      <% }) %>

      <div class="card">
        <div class="stat-label">¿Cómo saco el ID de un rol de Discord?</div>
        <p style="color:var(--ink-dim); font-size:.9rem; margin-top:.6rem;">
          Activa el "Modo desarrollador" en Discord (Ajustes → Avanzado), luego clic derecho sobre el rol en la configuración de tu servidor → "Copiar ID".
        </p>
      </div>
    </div>
  </main>
</body>
</html>
