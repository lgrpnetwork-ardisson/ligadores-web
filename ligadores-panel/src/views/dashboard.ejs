<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head') %></head>
<body>
  <%- include('partials/nav') %>
  <main>
    <div class="container">
      <div class="page-head">
        <div class="eyebrow">Exp. <%= user.id %></div>
        <h1>Mi expediente</h1>
        <p>Datos de tu personaje sincronizados directamente desde el servidor.</p>
      </div>

      <div class="card" style="margin-bottom:1.6rem;">
        <div class="stat-label">Guía de acceso</div>
        <h3 style="color:var(--white); font-size:1.3rem; margin:.5rem 0 1.4rem;">Cómo entrar al servidor</h3>
        <div class="steps-row steps-row-4" style="margin:0 0 1.4rem;">
          <div class="card step-tile">
            <div class="step-num">EXP-01</div>
            <h3 style="color:var(--white); font-size:1.05rem; margin-bottom:.5rem;">Instala GTA V</h3>
            <p style="color:var(--ink-dim); font-size:.88rem;">Necesitas una copia legítima del juego en Steam, Epic Games o Rockstar Games.</p>
          </div>
          <div class="card step-tile">
            <div class="step-num">EXP-02</div>
            <h3 style="color:var(--white); font-size:1.05rem; margin-bottom:.5rem;">Descarga FiveM</h3>
            <p style="color:var(--ink-dim); font-size:.88rem;">El launcher gratuito que te conecta a servidores como el nuestro.</p>
            <a href="https://fivem.net" target="_blank" rel="noopener" class="btn btn-ghost btn-small" style="margin-top:.8rem;">fivem.net ↗</a>
          </div>
          <div class="card step-tile">
            <div class="step-num">EXP-03</div>
            <h3 style="color:var(--white); font-size:1.05rem; margin-bottom:.5rem;">Crea tu cuenta Cfx.re</h3>
            <p style="color:var(--ink-dim); font-size:.88rem;">Regístrate gratis, es la cuenta que usa FiveM para conectarte a cualquier servidor.</p>
            <a href="https://cfx.re" target="_blank" rel="noopener" class="btn btn-ghost btn-small" style="margin-top:.8rem;">cfx.re ↗</a>
          </div>
          <div class="card step-tile">
            <div class="step-num">EXP-04</div>
            <h3 style="color:var(--white); font-size:1.05rem; margin-bottom:.5rem;">Conéctate</h3>
            <p style="color:var(--ink-dim); font-size:.88rem;">Abre FiveM, pulsa "Connect" y pega nuestra dirección, o búscanos por nombre.</p>
          </div>
        </div>
        <div class="ip-box">
          <div>
            <span class="stat-label" style="margin-bottom:.3rem;">Dirección de conexión</span>
            <span class="ip-value" id="ipValue">connect.ligadores.gg</span>
          </div>
          <button class="btn btn-ghost btn-small" id="copyIpBtn">Copiar IP</button>
        </div>
        <p style="color:var(--ink-faint); font-size:.82rem; margin-top:1rem;">
          ¿Primera vez? Revisa la <a href="/rules" style="color:var(--ink); border-bottom:1px solid var(--ink-faint);">normativa</a>
          y postúlate a un <a href="/jobs" style="color:var(--ink); border-bottom:1px solid var(--ink-faint);">trabajo</a> una vez estés dentro.
        </p>
      </div>

      <% if (!character) { %>
        <div class="empty-state">
          <p><strong>Todavía no encontramos un personaje vinculado a tu Discord.</strong></p>
          <p style="margin-top:.5rem;">Conéctate al servidor al menos una vez con este mismo Discord para que aparezcan tus datos aquí.</p>
        </div>
      <% } else { %>

        <div class="card character-header" style="margin-bottom:1.6rem;">
          <div class="mugshot">
            <% if (character.photo) { %>
              <img src="<%= character.photo %>" alt="Foto de <%= character.name %>">
            <% } else { %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
            <% } %>
          </div>
          <div>
            <div class="stat-label">Personaje</div>
            <h2 style="color:var(--white); font-size:1.6rem; margin:.4rem 0;"><%= character.name %></h2>
            <p style="color:var(--ink-dim); font-family:'JetBrains Mono', monospace; font-size:.85rem;">Trabajo: <%= character.job %></p>
          </div>
        </div>

        <div class="grid-3" style="margin-bottom:1.6rem;">
          <div class="card">
            <div class="stat-label">Efectivo</div>
            <div class="stat-value">$<%= Number(character.cash).toLocaleString('es-DO') %></div>
          </div>
          <div class="card">
            <div class="stat-label">Banco</div>
            <div class="stat-value">$<%= Number(character.bank).toLocaleString('es-DO') %></div>
          </div>
          <div class="card">
            <div class="stat-label">Tiempo jugado</div>
            <div class="stat-value"><%= Math.floor(character.playtimeMinutes / 60) %>h <%= character.playtimeMinutes % 60 %>m</div>
          </div>
        </div>

        <div class="grid-2" style="margin-bottom:1.6rem;">
          <div class="card">
            <div class="stat-label">Inventario</div>
            <% if (!character.inventory || !character.inventory.length) { %>
              <p style="color:var(--ink-dim); margin-top:.6rem;">Sin objetos registrados, o tu script de inventario no está conectado todavía a este panel.</p>
            <% } else { %>
              <div class="scroll-panel">
                <div class="chip-grid">
                  <% character.inventory.forEach(function(it){ %>
                    <div class="chip">
                      <div class="chip-icon">×<%= it.count || it.amount %></div>
                      <div class="chip-info">
                        <span class="chip-name"><%= (it.item || it.name || '').toString().replace(/_/g, ' ') %></span>
                        <span class="chip-sub">cantidad: <%= it.count || it.amount %></span>
                      </div>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% } %>
          </div>

          <div class="card">
            <div class="stat-label">Vehículos</div>
            <% if (!character.vehicles || !character.vehicles.length) { %>
              <p style="color:var(--ink-dim); margin-top:.6rem;">No tienes vehículos registrados en el garaje.</p>
            <% } else { %>
              <div class="scroll-panel">
                <div class="chip-grid">
                  <% character.vehicles.forEach(function(v){ %>
                    <div class="chip">
                      <div class="chip-icon"><%= (v.model || '??').toString().slice(0,2).toUpperCase() %></div>
                      <div class="chip-info">
                        <span class="chip-name"><%= v.model %></span>
                        <span class="chip-sub"><%= v.plate %> · <%= v.parked ? 'guardado' : 'fuera' %></span>
                      </div>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <div class="card">
          <div class="stat-label">Propiedades</div>
          <% if (!character.properties || !character.properties.length) { %>
            <p style="color:var(--ink-dim); margin-top:.6rem;">No tienes propiedades registradas.</p>
          <% } else { %>
            <div class="scroll-panel">
              <div class="chip-grid">
                <% character.properties.forEach(function(p){ %>
                  <div class="chip">
                    <div class="chip-icon">H</div>
                    <div class="chip-info">
                      <span class="chip-name"><%= p.type %></span>
                      <span class="chip-sub"><%= p.rented ? 'alquilada' : 'propia' %></span>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>
        </div>

      <% } %>
    </div>
  </main>
</body>
</html>
