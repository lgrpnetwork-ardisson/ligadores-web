<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head') %></head>
<body>
  <%- include('partials/nav') %>
  <main>
    <div class="container">
      <div class="page-head">
        <div class="eyebrow">Panel de jefe</div>
        <h1>Tus equipos</h1>
      </div>
      <div class="grid-3">
        <% jobs.forEach(function(job){ %>
          <a href="/jobs/boss/<%= job.id %>" class="card">
            <div class="stat-label"><%= job.label %></div>
            <div class="stat-value"><%= job.pendingCount %></div>
            <p style="color:var(--ink-dim); margin-top:.6rem;">postulaciones pendientes</p>
          </a>
        <% }) %>
      </div>
    </div>
  </main>
</body>
</html>
