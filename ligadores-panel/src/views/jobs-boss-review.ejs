<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head') %></head>
<body>
  <%- include('partials/nav') %>
  <main>
    <div class="container">
      <div class="page-head">
        <div class="eyebrow">Panel de jefe</div>
        <h1><%= job.label %></h1>
      </div>
      <% if (!applications.length) { %>
        <div class="empty-state">No hay postulaciones pendientes para este trabajo.</div>
      <% } else { %>
        <% applications.forEach(function(app){ %>
          <div class="card" style="margin-bottom:1.2rem;">
            <div class="stat-label">@<%= app.discord_username %> — <%= app.full_name %>, <%= app.age %> años</div>
            <p style="color:var(--ink-dim); margin:.8rem 0;"><%= app.motivation %></p>
            <% if (app.experience) { %><p style="color:var(--ink-faint); font-size:.85rem; margin-bottom:1rem;">Experiencia: <%= app.experience %></p><% } %>
            <div style="display:flex; gap:.8rem;">
              <form method="POST" action="/jobs/boss/<%= job.id %>/<%= app.id %>/approve">
                <button type="submit" class="btn btn-solid btn-small">Aprobar</button>
              </form>
              <form method="POST" action="/jobs/boss/<%= job.id %>/<%= app.id %>/reject">
                <button type="submit" class="btn btn-danger btn-small">Rechazar</button>
              </form>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </main>
</body>
</html>
