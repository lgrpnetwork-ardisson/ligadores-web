<header class="panel-nav">
  <div class="nav-inner">
    <a href="/" class="brand"><img src="/images/logo.svg" alt="Ligadores" class="brand-logo">LIGADORES</a>
    <nav>
      <a href="/dashboard">Mi expediente</a>
      <a href="/jobs">Trabajos</a>
      <a href="/jobs/boss">Panel de jefe</a>
      <a href="/shop">Mercado</a>
      <a href="/rules">Normativa</a>
      <% if (user && user.isAdmin) { %>
        <a href="/admin">Administración</a>
      <% } %>
    </nav>
    <% if (user) { %>
      <div class="user-chip">
        <img src="<%= user.avatarURL %>" alt="">
        <span><%= user.username %></span>
        <a href="/logout" class="btn btn-ghost btn-small">Salir</a>
      </div>
    <% } else { %>
      <a href="/login" class="btn btn-solid btn-small">Iniciar sesión</a>
    <% } %>
  </div>
</header>
